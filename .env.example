# Canonical sponsor-qualification fork.
BASE_RPC_URL=
BASE_FORK_BLOCK=51123118

# Optional public-testnet deployment. Supply a compatible Aqua deployment and
# verify every address with `npm --prefix packages/contracts run testnet:check`.

SEPOLIA_RPC_URL=
SEPOLIA_FORK_BLOCK=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
MAKER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

AQUA_ADDRESS=
WETH_ADDRESS=
USDC_ADDRESS=

MAX_QUOTE_TTL=120

# Public quote service and browser runtime (never put credential-bearing RPCs
# in PUBLIC_BROWSER_RPC_URL).
PUBLIC_BROWSER_RPC_URL=
PUBLIC_API_URL=
PUBLIC_FRONTEND_URL=
READINESS_TAKER_ADDRESS=
CORS_ORIGINS=http://127.0.0.1:4173
FIRMDEPTH_SETTLEMENT_ADDRESS=
VITE_FIRMDEPTH_API_URL=

# Azure CLI deployment names. Values must be supplied explicitly to the shell.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AZURE_PLAN=
AZURE_APP_NAME=
AZURE_KEY_VAULT=
AZURE_NODE_RUNTIME='NODE|24-lts'
# Optional workaround for a stalled App Service local MSI sidecar. Identity and Key Vault references remain enabled.
AZURE_DISABLE_LOCAL_MSI=false
# Existing StorageV2 account for compiled public frontend assets (Azure Blob Data Contributor required).
AZURE_FRONTEND_STORAGE_ACCOUNT=

# Filled only after deployment / source verification.
FIRM_SWAPVM_ROUTER_ADDRESS=
FIRM_REGISTRY_ADDRESS=
FIRM_BOND_VAULT_ADDRESS=
FIRM_EXECUTOR_ADDRESS=
